<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- Vector2Impl Visualizer -->
  <Type Name="se::math::Vector2Impl&lt;*&gt;">
    <Intrinsic Name="LengthSq" Expression="x*x + y*y"/>
    <DisplayString>{{ x={x,g}, y={y,g} }}</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>

      <Item Name="||v||">sqrt(LengthSq())</Item>
      <Item Name="||v||&#xB2;">LengthSq()</Item>

      <Synthetic Name="[normalized]" Condition="LengthSq() != 0">
        <DisplayString>{{ x={x / sqrt(LengthSq()),g}, y={y / sqrt(LengthSq()),g} }}</DisplayString>
        <Expand>
          <Item Name="x">x / sqrt(LengthSq())</Item>
          <Item Name="y">y / sqrt(LengthSq())</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- Vector3Impl Visualizer -->
  <Type Name="se::math::Vector3Impl&lt;*&gt;">
    <Intrinsic Name="LengthSq" Expression="x*x + y*y + z*z"/>
    <DisplayString>{{ x={x,g}, y={y,g}, z={z,g} }}</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>

      <Item Name="||v||">sqrt(LengthSq())</Item>
      <Item Name="||v||&#xB2;">LengthSq()</Item>

      <Synthetic Name="[normalized]" Condition="LengthSq() != 0">
        <DisplayString>{{ x={x / sqrt(LengthSq()),g}, y={y / sqrt(LengthSq()),g}, z={z / sqrt(LengthSq()),g} }}</DisplayString>
        <Expand>
          <Item Name="x">x / sqrt(LengthSq())</Item>
          <Item Name="y">y / sqrt(LengthSq())</Item>
          <Item Name="z">z / sqrt(LengthSq())</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- Vector4Impl Visualizer -->
  <Type Name="se::math::Vector4Impl&lt;*&gt;">
    <Intrinsic Name="LengthSq" Expression="x*x + y*y + z*z + w*w"/>
    <DisplayString>{{ x={x,g}, y={y,g}, z={z,g}, w={w,g} }}</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
      <Item Name="w">w</Item>

      <Item Name="||v||">sqrt(LengthSq())</Item>
      <Item Name="||v||&#xB2;">LengthSq()</Item>

      <Synthetic Name="[normalized]" Condition="LengthSq() != 0">
        <DisplayString>{{ x={x / sqrt(LengthSq()),g}, y={y / sqrt(LengthSq()),g}, z={z / sqrt(LengthSq()),g}, w={w / sqrt(LengthSq()),g} }}</DisplayString>
        <Expand>
          <Item Name="x">x / sqrt(LengthSq())</Item>
          <Item Name="y">y / sqrt(LengthSq())</Item>
          <Item Name="z">z / sqrt(LengthSq())</Item>
          <Item Name="w">w / sqrt(LengthSq())</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- Matrix4x4 -->
  <Type Name="se::math::Matrix4x4Impl&lt;*&gt;">
    <DisplayString>{{{{ {data[0],g}, {data[1],g}, {data[2],g}, {data[3],g} }}, ...}}</DisplayString>
    <Expand>
      <Synthetic Name="[0]">
        <DisplayString>{data[0],g}, {data[1],g}, {data[2],g}, {data[3],g}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>&amp;data[0]</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[1]">
        <DisplayString>{data[4],g}, {data[5],g}, {data[6],g}, {data[7],g}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>&amp;data[4]</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[2]">
        <DisplayString>{data[8],g}, {data[9],g}, {data[10],g}, {data[11],g}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>&amp;data[8]</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[3]">
        <DisplayString>{data[12],g}, {data[13],g}, {data[14],g}, {data[15],g}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>&amp;data[12]</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- Degree<T> -->
  <Type Name="se::math::AngleType&lt;*,se::math::DegreeTag&gt;">
    <DisplayString>{value,g}°</DisplayString>
    <Expand>
      <Item Name="value">value</Item>
      <Item Name="[rad]">value * 0.017453292519943295</Item>
    </Expand>
  </Type>

  <!-- Radian<T> -->
  <Type Name="se::math::AngleType&lt;*,se::math::RadianTag&gt;">
    <DisplayString>{value,g}_rad</DisplayString>
    <Expand>
      <Item Name="value">value</Item>
      <Item Name="[deg]">value * 57.29577951308232</Item>
    </Expand>
  </Type>

  <!-- RotatorImpl<T> -->
  <Type Name="se::math::RotatorImpl&lt;*&gt;">
    <DisplayString>{{ P={pitch.value,g}°, R={roll.value,g}°, Y={yaw.value,g}° }}</DisplayString>
    <Expand>
      <Item Name="Pitch (X)">pitch</Item>
      <Item Name="Roll  (Y)">roll</Item>
      <Item Name="Yaw   (Z)">yaw</Item>
    </Expand>
  </Type>

  <!-- QuaternionImpl<T> -->
  <Type Name="se::math::QuaternionImpl&lt;*&gt;">
    <Intrinsic Name="LengthSq" Expression="x*x + y*y + z*z + w*w"/>

    <DisplayString>{{ x={x,g}, y={y,g}, z={z,g}, w={w,g} }}</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
      <Item Name="w">w</Item>

      <Item Name="||q||">sqrt(LengthSq())</Item>

      <Synthetic Name="[normalized]" Condition="LengthSq() != 0">
        <DisplayString>{{ x={x/sqrt(LengthSq()),g}, y={y/sqrt(LengthSq()),g}, z={z/sqrt(LengthSq()),g}, w={w/sqrt(LengthSq()),g} }}</DisplayString>
        <Expand>
          <Item Name="x">x / sqrt(LengthSq())</Item>
          <Item Name="y">y / sqrt(LengthSq())</Item>
          <Item Name="z">z / sqrt(LengthSq())</Item>
          <Item Name="w">w / sqrt(LengthSq())</Item>
        </Expand>
      </Synthetic>

      <Synthetic Name="[conjugate]">
        <DisplayString>{{ x={-x,g}, y={-y,g}, z={-z,g}, w={w,g} }}</DisplayString>
        <Expand>
          <Item Name="x">-x</Item>
          <Item Name="y">-y</Item>
          <Item Name="z">-z</Item>
          <Item Name="w">w</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- AABBImpl<T> -->
  <Type Name="se::math::AABBImpl&lt;*&gt;">
    <Intrinsic Name="IsValid" Expression="min.x &lt;= max.x &amp;&amp; min.y &lt;= max.y &amp;&amp; min.z &lt;= max.z"/>

    <DisplayString Condition="!IsValid()">Invalid</DisplayString>
    <DisplayString Condition="IsValid()">{{ min={min}, max={max} }}</DisplayString>
    <Expand>
      <Item Name="min">min</Item>
      <Item Name="max">max</Item>

      <Synthetic Name="[size]">
        <DisplayString>{{ x={max.x - min.x,g}, y={max.y - min.y,g}, z={max.z - min.z,g} }}</DisplayString>
        <Expand>
          <Item Name="x">max.x - min.x</Item>
          <Item Name="y">max.y - min.y</Item>
          <Item Name="z">max.z - min.z</Item>
        </Expand>
      </Synthetic>

      <Synthetic Name="[center]">
        <DisplayString>{{ x={(min.x + max.x) * 0.5,g}, y={(min.y + max.y) * 0.5,g}, z={(min.z + max.z) * 0.5,g} }}</DisplayString>
        <Expand>
          <Item Name="x">(min.x + max.x) * 0.5</Item>
          <Item Name="y">(min.y + max.y) * 0.5</Item>
          <Item Name="z">(min.z + max.z) * 0.5</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- RayImpl<T> -->
  <Type Name="se::math::RayImpl&lt;*&gt;">
    <DisplayString>{{ origin={origin}, direction={direction} }}</DisplayString>
    <Expand>
      <Item Name="origin">origin</Item>
      <Item Name="direction">direction</Item>
    </Expand>
  </Type>

  <!-- Color -->
  <Type Name="se::math::Color">
    <Intrinsic Name="ToHexInt" Expression="((unsigned int)r &lt;&lt; 24) | ((unsigned int)g &lt;&lt; 16) | ((unsigned int)b &lt;&lt; 8) | (unsigned int)a" />

    <DisplayString>{{ R={(int)r}, G={(int)g}, B={(int)b}, A={(int)a} }}</DisplayString>
    <Expand>
      <Item Name="R">(int)r</Item>
      <Item Name="G">(int)g</Item>
      <Item Name="B">(int)b</Item>
      <Item Name="A">(int)a</Item>

      <Item Name="[hex]">ToHexInt(),X</Item>
    </Expand>
  </Type>

  <!-- LinearColor -->
  <Type Name="se::math::LinearColor">
    <DisplayString>{{ R={r,g}, G={g,g}, B={b,g}, A={a,g} }}</DisplayString>
    <Expand>
      <Item Name="R">r</Item>
      <Item Name="G">g</Item>
      <Item Name="B">b</Item>
      <Item Name="A">a</Item>

      <Item Name="[luma]">r * 0.2126f + g * 0.7152f + b * 0.0722f</Item>
      <Item Name="[max]">(r > g ? (r > b ? r : b) : (g > b ? g : b))</Item>
      <Item Name="[is_hdr]">r > 1.0f || g > 1.0f || b > 1.0f</Item>
    </Expand>
  </Type>

  <!-- Optional<T> -->
  <Type Name="Optional&lt;*&gt;">
    <DisplayString Condition="!is_value_set">nullopt</DisplayString>
    <DisplayString Condition="is_value_set">{(const $T1&amp;)storage}</DisplayString>
    <Expand>
      <Item Name="[has_value]" ExcludeView="simple">is_value_set</Item>
      <Item Name="[value]" Condition="is_value_set">(const $T1&amp;)storage</Item>
    </Expand>
  </Type>

  <!-- Optional<T&> -->
  <!--  <Type Name="Optional&lt;*&amp;&gt;">-->
  <!--    <Intrinsic Name="has_value" Expression="ref_ptr != 0"/>-->
  <!--    <Intrinsic Name="get_value" Expression="*ref_ptr"/>-->
  <!--    <DisplayString Condition="!has_value()">nullopt</DisplayString>-->
  <!--    <DisplayString Condition="has_value()">{get_value()}</DisplayString>-->
  <!--    <Expand>-->
  <!--      <Item Name="[has_value]" ExcludeView="simple">has_value()</Item>-->
  <!--      <Item Name="[value]" Condition="has_value()">get_value()</Item>-->
  <!--      <Item Name="[address]" IncludeView="detailed">ref_ptr</Item>-->
  <!--    </Expand>-->
  <!--  </Type>-->

  <!-- Expected<T, E> -->
  <Type Name="se::Expected&lt;*,*&gt;">
    <DisplayString Condition="has_value">Ok({storage.value})</DisplayString>
    <DisplayString Condition="!has_value">Err({storage.error})</DisplayString>
    <Expand>
      <ExpandedItem Condition="has_value">storage.value</ExpandedItem>
      <ExpandedItem Condition="!has_value">storage.error</ExpandedItem>
    </Expand>
  </Type>

  <!-- Expected<void, E> -->
  <Type Name="se::Expected&lt;void,*&gt;">
    <DisplayString Condition="has_value">Ok(void)</DisplayString>
    <DisplayString Condition="!has_value">Err({storage.error})</DisplayString>
    <Expand>
      <ExpandedItem Condition="!has_value">storage.error</ExpandedItem>
    </Expand>
  </Type>

  <!-- StringName -->
  <Type Name="se::StringName">
    <DisplayString Condition="display_name == nullptr">None</DisplayString>
    <DisplayString Condition="display_name != nullptr">{display_name,s8}</DisplayString>
    <Expand>
      <Item Name="[display_name]">display_name</Item>
      <Item Name="[comparison_hash]">comparison_hash</Item>
    </Expand>
  </Type>

  <!-- FixedArray<T, N> -->
  <Type Name="se::FixedArray&lt;*,*&gt;">
    <DisplayString>{{ size={$T2} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>$T2</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- Array<T> -->
  <Type Name="se::Array&lt;*&gt;">
    <DisplayString Condition="size == 0 &amp;&amp; capacity == 0">Empty</DisplayString>
    <DisplayString Condition="size &lt; 0">Invalid</DisplayString>
    <DisplayString Condition="capacity &lt; size">Invalid</DisplayString>
    <DisplayString Condition="capacity &gt;= size">{{ size={size} capacity={capacity} }}</DisplayString>
    <Expand>
      <Item Name="[size]">size</Item>
      <Item Name="[capacity]">capacity</Item>
      <ArrayItems>
        <Size>size</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- String -->
  <Type Name="se::BaseString&lt;*&gt;">
    <DisplayString>{data.data,s8}</DisplayString>
    <StringView>data.data,s8</StringView>
    <Expand>
      <Item Name="[length]">data.size</Item>
      <Item Name="[capacity]">data.capacity</Item>
      <Item Name="[buffer]">data.data,s8</Item>
    </Expand>
  </Type>

  <!-- Deque<T> -->
  <Type Name="se::Deque&lt;*&gt;">
    <DisplayString>{internal_deque}</DisplayString>
    <Expand>
      <ExpandedItem>internal_deque</ExpandedItem>
    </Expand>
  </Type>

  <!-- HashMap<K, V> -->
  <Type Name="se::HashMap&lt;*&gt;">
    <DisplayString>{internal_map}</DisplayString>
    <Expand>
      <ExpandedItem>internal_map</ExpandedItem>
    </Expand>
  </Type>

  <!-- HashSet<T> -->
  <Type Name="se::HashSet&lt;*&gt;">
    <DisplayString>{internal_map}</DisplayString>
    <Expand>
      <ExpandedItem>internal_map</ExpandedItem>
    </Expand>
  </Type>

  <!-- Map<K, V> -->
  <Type Name="se::Map&lt;*&gt;">
    <DisplayString>{internal_map}</DisplayString>
    <Expand>
      <ExpandedItem>internal_map</ExpandedItem>
    </Expand>
  </Type>

  <!-- Set<T> -->
  <Type Name="se::Set&lt;*&gt;">
    <DisplayString>{internal_map}</DisplayString>
    <Expand>
      <ExpandedItem>internal_map</ExpandedItem>
    </Expand>
  </Type>

  <!-- Queue<T> -->
  <Type Name="se::Queue&lt;*&gt;">
    <DisplayString>{container}</DisplayString>
    <Expand>
      <ExpandedItem>container</ExpandedItem>
    </Expand>
  </Type>

  <!-- Stack<T> -->
  <Type Name="se::Stack&lt;*&gt;">
    <DisplayString>{container}</DisplayString>
    <Expand>
      <ExpandedItem>container</ExpandedItem>
    </Expand>
  </Type>

  <!-- ArrayView<T, DynamicExtent> -->
  <Type Name="se::ArrayView&lt;*,18446744073709551615&gt;">
    <DisplayString Condition="data_len == 0">Empty</DisplayString>
    <DisplayString Condition="data_len &gt; 0">{{ size={data_len} }}</DisplayString>
    <Expand>
      <Item Name="[size]">data_len</Item>
      <Item Name="[data]">data_ptr</Item>
      <ArrayItems>
        <Size>data_len</Size>
        <ValuePointer>data_ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- ArrayView<T, N> (static extent) -->
  <Type Name="se::ArrayView&lt;*,*&gt;">
    <DisplayString>{{ size={$T2} }}</DisplayString>
    <Expand>
      <Item Name="[size]">$T2</Item>
      <Item Name="[data]">data_ptr</Item>
      <ArrayItems>
        <Size>$T2</Size>
        <ValuePointer>data_ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- StringView -->
  <Type Name="se::StringView">
    <DisplayString>{data_ptr,[data_len]s8}</DisplayString>
    <StringView>data_ptr,[data_len]s8</StringView>
    <Expand>
      <Item Name="[length]">data_len</Item>
      <Item Name="[data]">data_ptr,[data_len]s8</Item>
      <Item Name="[is_empty]">data_len == 0</Item>
    </Expand>
  </Type>

  <!-- Guid -->
  <Type Name="se::Guid">
    <DisplayString>
      <!-- https://stackoverflow.com/questions/17436643/i-am-looking-for-a-proper-way-to-display-a-uuid-via-natvis-in-vs2012 -->
      {data[0],nvoXb}{data[1],nvoXb}{data[2],nvoXb}{data[3],nvoXb}-{data[4],nvoXb}{data[5],nvoXb}-{data[6],nvoXb}{data[7],nvoXb}-{data[8],nvoXb}{data[9],nvoXb}-{data[10],nvoXb}{data[11],nvoXb}{data[12],nvoXb}{data[13],nvoXb}{data[14],nvoXb}{data[15],nvoXb}
    </DisplayString>
    <Expand>
      <Item Name="[Raw Bytes]">data</Item>
    </Expand>
  </Type>

  <!-- AssetId -->
  <Type Name="se::asset::AssetId">
    <DisplayString>{guid}</DisplayString>
    <Expand>
      <Item Name="guid">guid</Item>
    </Expand>
  </Type>

  <!-- Path -->
  <Type Name="se::Path">
    <DisplayString>{internal_path}</DisplayString>
    <Expand>
      <ExpandedItem>internal_path</ExpandedItem>
    </Expand>
  </Type>

  <!-- VPath -->
  <Type Name="se::VPath">
    <DisplayString>{full_path}</DisplayString>
    <Expand>
      <Item Name="[full_path]">full_path</Item>
      <Synthetic Name="[scheme]" Condition="scheme_len > 0">
        <DisplayString>{full_path.data.data,[scheme_len]s8}</DisplayString>
      </Synthetic>
      <Synthetic Name="[path]">
        <DisplayString>{full_path.data.data + path_offset,s8}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <!-- AssetPath -->
  <Type Name="se::asset::AssetPath">
    <DisplayString Condition="sub_asset_name.data.size == 0">{file_path}</DisplayString>
    <DisplayString Condition="sub_asset_name.data.size != 0">{file_path}#{sub_asset_name}</DisplayString>
    <Expand>
      <Item Name="file_path">file_path</Item>
      <Item Name="sub_asset_name">sub_asset_name</Item>
    </Expand>
  </Type>

  <!-- AssetHandle<T> -->
  <Type Name="se::asset::AssetHandle&lt;*&gt;">
    <Intrinsic Name="GetSlot" Expression="table->slots.data[index]"/>
    <Intrinsic Name="IsStale" Expression="GetSlot().generation != generation"/>
    <Intrinsic Name="GetAsset" Expression="($T1*)GetSlot().asset._Storage._Value"/>

    <DisplayString Condition="table == 0 || index == 0xFFFFFFFF">invalid</DisplayString>
    <DisplayString Condition="IsStale()">stale</DisplayString>
    <DisplayString Condition="!IsStale()">{GetAsset()}</DisplayString>
    <Expand>
      <Item Name="[asset]" Condition="!IsStale()">GetAsset()</Item>
      <Item Name="[state]" Condition="!IsStale()">GetSlot().state._Storage._Value</Item>
      <Item Name="[ref_count]" Condition="!IsStale()">GetSlot().ref_count._Storage._Value</Item>
      <Item Name="[path]" Condition="!IsStale()">GetSlot().source_path</Item>
      <Item Name="[index]">index</Item>
      <Item Name="[generation]">generation</Item>
      <Item Name="[table]">table</Item>
    </Expand>
  </Type>
</AutoVisualizer>

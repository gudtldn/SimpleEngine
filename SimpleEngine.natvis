<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- StringName -->
  <Type Name="StringName">
    <DisplayString Condition="debug_entry_ptr == nullptr">"None"</DisplayString>
    <DisplayString Condition="debug_entry_ptr != nullptr">
      {(const char8*)((StringNameEntry*)debug_entry_ptr)->name,s8}
    </DisplayString>
    <Expand>
      <Item Name="[display_hash]">display_hash</Item>
      <Item Name="[comparison_hash]">comparison_hash</Item>
    </Expand>
  </Type>

  <!-- Matrix4x4 -->
  <Type Name="se::math::Matrix4x4Impl&lt;*&gt;">
    <DisplayString>Matrix4x4</DisplayString>
    <Expand>
      <Synthetic Name="[0]">
        <DisplayString>{data[0]}, {data[1]}, {data[2]}, {data[3]}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>($T1*)&amp;data</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[1]">
        <DisplayString>{data[4]}, {data[5]}, {data[6]}, {data[7]}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>($T1*)(&amp;data)+4</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[2]">
        <DisplayString>{data[8]}, {data[9]}, {data[10]}, {data[11]}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>($T1*)(&amp;data)+8</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[3]">
        <DisplayString>{data[12]}, {data[13]}, {data[14]}, {data[15]}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>4</Size>
            <ValuePointer>($T1*)(&amp;data)+12</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- Optional<T> -->
  <Type Name="Optional&lt;*&gt;">
    <DisplayString Condition="!is_value_set">nullopt</DisplayString>
    <DisplayString Condition="is_value_set">{*($T1*)storage}</DisplayString>
    <Expand>
      <Item Name="[has_value]" ExcludeView="simple">is_value_set</Item>
      <Item Name="[value]" Condition="is_value_set">*($T1*)storage</Item>
    </Expand>
  </Type>

  <!-- Optional<T&> -->
  <!--  <Type Name="Optional&lt;*&amp;&gt;">-->
  <!--    <Intrinsic Name="has_value" Expression="ref_ptr != 0"/>-->
  <!--    <Intrinsic Name="get_value" Expression="*ref_ptr"/>-->
  <!--    <DisplayString Condition="!has_value()">nullopt</DisplayString>-->
  <!--    <DisplayString Condition="has_value()">{get_value()}</DisplayString>-->
  <!--    <Expand>-->
  <!--      <Item Name="[has_value]" ExcludeView="simple">has_value()</Item>-->
  <!--      <Item Name="[value]" Condition="has_value()">get_value()</Item>-->
  <!--      <Item Name="[address]" IncludeView="detailed">ref_ptr</Item>-->
  <!--    </Expand>-->
  <!--  </Type>-->
</AutoVisualizer>

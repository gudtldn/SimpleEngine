{
  "name": "sdl3-shadercross",
  "version": "3.0.0",
  "port-version": 0,
  "description": "SDL3 Shader Cross Compiler - translates shaders between HLSL, SPIR-V and platform-specific GPU shader formats",
  "homepage": "https://github.com/libsdl-org/SDL_shadercross",
  "license": "Zlib",
  "supports": "!uwp",
  "dependencies": [
    { "name": "sdl3" },
    { "name": "spirv-cross" },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "dxc": {
      "description": "Enable HLSL compilation via DirectX Shader Compiler (DXC)",
      "supports": "windows",
      "dependencies": [
        { "name": "directx-dxc" }
      ]
    },
    "cli": {
      "description": "Build the shadercross command-line tool"
    }
  },
  "default-features": [
    { "name": "dxc", "platform": "windows" }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{3EF8A1DA-D347-4303-9310-C5208EE0199B}</ProjectGuid>
    <RootNamespace>EditorEngine</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>

    <!-- ThirdParty Folder Path 설정 -->
    <ThirdPartyDir>$(SolutionDir)ThirdParty\</ThirdPartyDir>
    <SDL3_ShaderCrossThirdPartyDir>$(ThirdPartyDir)SDL3_shadercross\</SDL3_ShaderCrossThirdPartyDir>
    <ImGui_ThirdPartyDir>$(ThirdPartyDir)ImGui\</ImGui_ThirdPartyDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(SDL3_ShaderCrossThirdPartyDir)include;
        $(ImGui_ThirdPartyDir);
        $(ImGui_ThirdPartyDir)backends;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>SDL3_shadercross.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SDL3_ShaderCrossThirdPartyDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /Y /D "$(SolutionDir)ThirdParty\SDL3_shadercross\bin\*.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- ImGui 소스 파일들 -->
    <ClCompile Include="$(ImGui_ThirdPartyDir)imgui.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)imgui_demo.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)imgui_draw.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)imgui_tables.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)imgui_widgets.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)backends\imgui_impl_sdl3.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)backends\imgui_impl_sdlgpu3.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="$(ImGui_ThirdPartyDir)backends\imgui_impl_win32.cpp">
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>

    <!-- EditorEngine의 소스 파일들 -->
    <ClCompile Include="Source\**\*.cpp"/>
    <ClCompile Include="Source\**\*.cppm"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EngineCore\EngineCore.vcxproj">
      <Project>{70359232-4bc5-40b2-bd1f-3f6b5f19f1e3}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
